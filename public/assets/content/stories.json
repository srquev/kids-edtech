      "hi": {
        "title": "खरगोश की पिकनिक",
        "theme": "दोस्त के साथ बाँटना",
        "question": "खरगोश ने क्या बाँटा?",
        "options": [
          {
            "id": "apple",
            "text": "एक सेब"
